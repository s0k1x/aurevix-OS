<Window x:Class="Aurevix.ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AUREVIX Control Center" Width="1180" Height="760" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        Icon="pack://application:,,,/Assets/aurevix.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barra lateral -->
        <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource BorderBrushAx}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,24,16,22">
                    <TextBlock Text="AUREVIX" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource Accent}" />
                    <TextBlock Text="Control Center" Style="{StaticResource Muted}" />
                </StackPanel>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="22,0,16,18" FontSize="12" />
                <StackPanel x:Name="Nav" Margin="0,0,0,8">
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Inicio" x:Name="NavHome" IsChecked="True" Checked="OnNav" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE9D9;" Content="Diagnóstico" x:Name="NavDiagnostics" Checked="OnNav" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE9D2;" Content="Rendimiento" x:Name="NavPerformance" Checked="OnNav" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE945;" Content="Perfiles" x:Name="NavProfiles" Checked="OnNav" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Optimización" x:Name="NavOptimization" Checked="OnNav" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE771;" Content="Apariencia" x:Name="NavAppearance" Checked="OnNav" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE895;" Content="Actualizaciones" x:Name="NavUpdates" Checked="OnNav" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE777;" Content="Recuperación" x:Name="NavRecovery" Checked="OnNav" />
                    <RadioButton Style="{StaticResource NavItem}" Tag="&#xE115;" Content="Ajustes" x:Name="NavSettings" Checked="OnNav" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl x:Name="PageHost" Grid.Column="1" />
    </Grid>
</Window>
