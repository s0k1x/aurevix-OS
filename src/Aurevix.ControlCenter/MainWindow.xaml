<Window x:Class="Aurevix.ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AUREVIX Control Center" Width="1240" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        Icon="pack://application:,,,/Assets/aurevix.ico">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Brillo verde muy sutil en la esquina: da profundidad sin romper el minimalismo -->
        <Ellipse Grid.ColumnSpan="2" Width="900" Height="900" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-520,-380,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="{StaticResource GlowColor}" Offset="0" />
                    <GradientStop Color="#008DE03C" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Barra lateral -->
        <Border Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource BorderBrushAx}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="24,26,16,18" Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/aurevix.ico" Width="28" Height="28" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AUREVIX" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Control Center" Style="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="VersionText" DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="24,8,16,18" FontSize="12" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Nav" Margin="0,0,0,8">
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE80F;" Content="Inicio" x:Name="NavHome" IsChecked="True" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE9D9;" Content="Diagnóstico" x:Name="NavDiagnostics" Checked="OnNav" />

                        <TextBlock Text="RENDIMIENTO" Style="{StaticResource Eyebrow}" Margin="26,16,0,4" FontSize="11" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE713;" Content="Optimización" x:Name="NavOptimization" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE7FC;" Content="Game Boost" x:Name="NavGameBoost" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xEC4A;" Content="Benchmark" x:Name="NavBenchmark" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE968;" Content="Red" x:Name="NavNetwork" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE9D2;" Content="Monitor" x:Name="NavPerformance" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE945;" Content="Perfiles" x:Name="NavProfiles" Checked="OnNav" />

                        <TextBlock Text="SISTEMA" Style="{StaticResource Eyebrow}" Margin="26,16,0,4" FontSize="11" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE771;" Content="Apariencia" x:Name="NavAppearance" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE74D;" Content="Limpieza" x:Name="NavCleanup" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE90F;" Content="Herramientas" x:Name="NavTools" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE719;" Content="Apps" x:Name="NavApps" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE895;" Content="Actualizaciones" x:Name="NavUpdates" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE777;" Content="Recuperación" x:Name="NavRecovery" Checked="OnNav" />
                        <RadioButton Style="{StaticResource NavItem}" Tag="&#xE115;" Content="Ajustes" x:Name="NavSettings" Checked="OnNav" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <ContentControl x:Name="PageHost" Grid.Column="1" />
    </Grid>
</Window>
