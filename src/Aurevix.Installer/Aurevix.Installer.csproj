<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>AurevixInstaller</AssemblyName>
    <RootNamespace>Aurevix.Installer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\Aurevix.ControlCenter\Assets\aurevix.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aurevix.Core\Aurevix.Core.csproj" />
    <ProjectReference Include="..\Aurevix.Update\Aurevix.Update.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Mismo tema y kit de UI que el Control Center -->
    <Page Include="..\Aurevix.ControlCenter\Themes\Aurevix.xaml" Link="Themes\Aurevix.xaml" />
    <Page Include="..\Aurevix.ControlCenter\Themes\AurevixLight.xaml" Link="Themes\AurevixLight.xaml" />
    <Compile Include="..\Aurevix.ControlCenter\Views\Ui.cs" Link="Views\Ui.cs" />
    <Resource Include="..\Aurevix.ControlCenter\Assets\aurevix.ico" Link="Assets\aurevix.ico" />
    <EmbeddedResource Include="..\..\iso-builder\autounattend.xml" LogicalName="autounattend.xml" />
    <EmbeddedResource Include="..\..\iso-builder\SetupComplete.cmd" LogicalName="SetupComplete.cmd" />
    <EmbeddedResource Include="..\..\third_party\fido\Fido.ps1" LogicalName="Fido.ps1" />
  </ItemGroup>
</Project>
